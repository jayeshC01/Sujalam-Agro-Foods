# ==============================================================================
# Sujalam Agro Foods Backend - Environment Configuration Template
# Copy this file to .env and fill in your local or production credentials.
# NEVER commit .env to Git!
# ==============================================================================

# Application Port
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/sujalam_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Brevo SMTP Mail Server Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_login
SMTP_PASSWORD=your_brevo_smtp_master_key
APP_MAIL_FROM=noreply@sujalamagro.com
APP_MAIL_ADMIN=admin@sujalamagro.com

# Firebase Authentication (Path to Google Service Account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Swagger / OpenAPI UI (Set to false in production to restrict docs to Admin)
APP_SWAGGER_PUBLIC=true
